<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.oken1.modules.calendar.dao.CalendarCustomDao">

    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="io.oken1.modules.calendar.entity.CalendarCustomEntity" id="calendarCustomMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="userId" column="user_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="remind" column="remind"/>
        <result property="type" column="type"/>
        <result property="remark" column="remark"/>
        <result property="deleted" column="deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="updateTime"/>
        <result property="updateBy" column="updateBy"/>
    </resultMap>

    <!--自定义日历列表-->
    <select id="getCustomList" resultType="map">
        select id, name, user_id, start_time, end_time, remind, type, remark, deleted, create_time, create_by, update_time, update_by
        from calendar_custom c
        where c.user_id = #{userId} and deleted = 0
    </select>
    <update id="delCustom">
        UPDATE calendar_custom SET deleted = 1 WHERE id = #{id};
    </update>

</mapper>